# Per-env files:
#   .env.staging      — staging DB + staging keys (used by pnpm db:*:staging)
#   .env.production   — production DB + prod keys (used by pnpm db:*:prod)
#   .env.local        — your local dev (defaults to staging-equivalent)
# All three are gitignored. Vercel reads its own env vars from the dashboard.

# ── Env mode ─────────────────────────────────────────────────────────────────
# Local override. On Vercel, this is auto-derived from VERCEL_ENV.
# Set to "production" when pointing local code at the production DB.
NEXT_PUBLIC_ENV_MODE=staging

# ── Neon Postgres ────────────────────────────────────────────────────────────
# Different connection string per env file.
DATABASE_URL=

# ── Upstash Redis (optional — cached() falls through if unset) ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── ImageKit — https://imagekit.io ───────────────────────────────────────────
# One account; folder prefix isolates staging from prod uploads.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER_PREFIX=staging   # set to "prod" on production deploy
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Base URL of this deployment (e.g. http://localhost:3000 or https://alvari.in)
BETTER_AUTH_URL=
# Google OAuth for customer sign-in (Google Cloud Console → Credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Public site config ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Admin login ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Anthropic API — content engine ───────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ── Vercel Cron — shared secret protecting /api/cron/* endpoints ─────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Staging-only ─────────────────────────────────────────────────────────────
# If set, staging requires basic auth (user can be anything, password = this).
STAGING_PASSWORD=

# ── Error tracking ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ── IndexNow — instant URL submission to Bing/Yandex/etc. ────────────────────
# Any random string (e.g. openssl rand -hex 16). Published at /indexnow-key.txt
# and sent with each product/blog change. Only fires in production.
INDEXNOW_KEY=

# ── Razorpay — https://dashboard.razorpay.com ────────────────────────────────
# Key id/secret from Settings → API Keys. Webhook secret from Settings →
# Webhooks (events: payment.captured, payment_link.paid).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
